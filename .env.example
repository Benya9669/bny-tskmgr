# Generate a long random value, for example: openssl rand -hex 32
TASKFLOW_SECRET=replace-with-a-long-random-secret
TASKFLOW_TOKEN_TTL_DAYS=30
TASKFLOW_PUBLIC_URL=http://localhost:8080
# SMTP is required for new account registration.
TASKFLOW_SMTP_HOST=smtp.example.com
TASKFLOW_SMTP_PORT=587
# starttls (recommended), ssl, or plain for a trusted local relay only
TASKFLOW_SMTP_MODE=starttls
TASKFLOW_SMTP_USERNAME=taskflow@example.com
TASKFLOW_SMTP_PASSWORD=replace-with-an-smtp-password
TASKFLOW_SMTP_FROM=taskflow@example.com
TASKFLOW_VERIFICATION_TTL_HOURS=24
# Set this only if a web client is hosted on another origin.
TASKFLOW_ALLOWED_ORIGIN=
# Release Compose options. Keep 127.0.0.1 when using a local reverse proxy.
TASKFLOW_BIND_ADDRESS=127.0.0.1
TASKFLOW_PORT=8080
TASKFLOW_VERSION=latest
